---
permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Admin — URE Marília</title>
<style>
:root{--bg:#F5F8FC;--surface:#fff;--line:#D7E0EA;--ink:#0E1F35;--muted:#7A8FA8;--blue:#2563EB;--teal:#0D9488;--amber:#D97706;--red:#DC2626;--radius:14px;--font:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;--mono:ui-monospace,Consolas,monospace}
*{box-sizing:border-box}body{margin:0;font-family:var(--font);background:var(--bg);color:var(--ink);line-height:1.5}
a{color:var(--blue)}button,input,select,textarea{font:inherit}
.hidden{display:none!important}.muted{color:var(--muted);font-size:13px}
.wrap{max-width:1200px;margin:0 auto;padding:20px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:22px;margin:0}h2{font-size:16px;margin:0 0 10px}h3{font-size:14px;margin:0 0 8px}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;font-weight:600;font-size:13px}
.btn:hover{border-color:#94a3b8}.btn-primary{background:var(--blue);color:#fff;border-color:var(--blue)}.btn-danger{color:var(--red);border-color:#fecaca}.btn-sm{padding:6px 10px;font-size:12px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px}
.grid{display:grid;grid-template-columns:320px 1fr;gap:16px}@media(max-width:950px){.grid{grid-template-columns:1fr}}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:700px){.grid-2{grid-template-columns:1fr}}
.field{margin-bottom:12px}.field label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
.field input[type=text],.field input[type=email],.field input[type=password],.field input[type=date],.field select,.field textarea{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff}
.field textarea{min-height:200px;font-family:var(--mono);font-size:13px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:700px){.row{grid-template-columns:1fr}}
.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;max-height:65vh;overflow:auto}
.item{border:1px solid var(--line);border-radius:10px;padding:10px;cursor:pointer}.item:hover{border-color:#94a3b8}.item.active{border-color:var(--blue);background:#f8fbff}
.item-title{font-weight:700;font-size:14px;margin:0 0 4px}.item-meta{font-size:12px;color:var(--muted)}
.pill{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:#eef2ff;color:var(--blue);font-weight:700}
.pill.draft{background:#fef3c7;color:#92400e}.pill.admin{background:#ede9fe;color:#5b21b6}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.tab{padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:var(--surface);cursor:pointer;font-weight:600;font-size:13px}
.tab.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.notice{font-size:13px;color:var(--muted);background:#fff;border:1px dashed var(--line);border-radius:10px;padding:10px 12px;margin-bottom:14px}
.stats{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}.stat{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px;min-width:120px}
.stat b{display:block;font-size:20px}.stat span{font-size:12px;color:var(--muted)}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line);font-size:13px}th{font-size:12px;color:var(--muted);text-transform:uppercase}
.toast{position:fixed;right:16px;bottom:16px;background:#0E1F35;color:#fff;padding:10px 14px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;z-index:50}
.toast.show{opacity:1;transform:none}
.login{max-width:420px;margin:60px auto}
.error{color:var(--red);font-size:13px;margin-top:6px}
.search input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:10px}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div>
      <h1>Admin — Caderno da Rede</h1>
      <div class="muted" id="modeLabel">Modo demonstração (local)</div>
    </div>
    <div class="bar">
      <a class="btn btn-sm" href="/" target="_blank">Ver site</a>
      <button class="btn btn-sm hidden" id="btnLogout">Sair</button>
    </div>
  </div>

  <div id="loginView" class="login card">
    <h2>Entrar</h2>
    <p class="muted">Use e-mail e senha. Em modo demonstração, o acesso local é liberado com qualquer usuário criado nesta tela (armazenado no navegador). Com Supabase configurado, usa autenticação real.</p>
    <div class="field"><label for="loginEmail">E-mail</label><input type="email" id="loginEmail" autocomplete="username"></div>
    <div class="field"><label for="loginPass">Senha</label><input type="password" id="loginPass" autocomplete="current-password"></div>
    <div class="bar">
      <button class="btn btn-primary" id="btnLogin">Entrar</button>
      <button class="btn" id="btnDemo">Entrar em modo demo</button>
    </div>
    <div class="error" id="loginError"></div>
  </div>

  <div id="appView" class="hidden">
    <div class="tabs">
      <button class="tab active" data-tab="posts">Postagens</button>
      <button class="tab" data-tab="users">Usuários</button>
      <button class="tab" data-tab="settings">Configurações</button>
    </div>

    <section id="tab-posts">
      <div class="stats">
        <div class="stat"><b id="stPosts">0</b><span>publicações</span></div>
        <div class="stat"><b id="stPublished">0</b><span>publicadas</span></div>
        <div class="stat"><b id="stDrafts">0</b><span>rascunhos</span></div>
        <div class="stat"><b id="stTags">0</b><span>tags únicas</span></div>
      </div>
      <div class="grid">
        <aside class="card">
          <h2>Postagens</h2>
          <div class="search"><input type="text" id="postSearch" placeholder="Buscar por título ou tag"></div>
          <div class="bar" style="margin-bottom:10px">
            <button class="btn btn-primary btn-sm" id="btnNewPost">Nova postagem</button>
            <button class="btn btn-sm" id="btnExport">Exportar JSON</button>
            <button class="btn btn-sm" id="btnImport">Importar</button>
            <input type="file" id="fileInput" accept="application/json" class="hidden">
          </div>
          <ul class="list" id="postList"></ul>
        </aside>
        <main class="card">
          <h2 id="postFormTitle">Editor de postagem</h2>
          <form id="postForm">
            <input type="hidden" id="postId">
            <div class="field"><label for="title">Título</label><input type="text" id="title" required></div>
            <div class="field"><label for="resumo">Resumo</label><input type="text" id="resumo"></div>
            <div class="row">
              <div class="field"><label for="categoria">Categoria</label>
                <select id="categoria"><option value="noticia">Notícia</option><option value="comunicado">Comunicado</option><option value="formacao">Formação</option><option value="material">Material</option><option value="projeto">Projeto</option><option value="evento">Evento</option></select>
              </div>
              <div class="field"><label for="data">Data</label><input type="date" id="data"></div>
            </div>
            <div class="row">
              <div class="field"><label for="autor">Autor</label><input type="text" id="autor" value="Equipe URE Marília"></div>
              <div class="field"><label for="status">Status</label>
                <select id="status"><option value="published">Publicado</option><option value="draft">Rascunho</option><option value="review">Em revisão</option><option value="archived">Arquivado</option></select>
              </div>
            </div>
            <div class="field"><label for="tags">Tags (vírgula)</label><input type="text" id="tags" placeholder="ex: leitura, professores"></div>
            <div class="field"><label><input type="checkbox" id="destaque"> Destaque na página inicial</label></div>
            <div class="field"><label for="conteudo">Conteúdo (Markdown)</label><textarea id="conteudo"></textarea></div>
            <div class="bar">
              <button type="submit" class="btn btn-primary">Salvar postagem</button>
              <button type="button" class="btn btn-danger" id="btnDeletePost">Excluir</button>
              <button type="button" class="btn" id="btnDuplicatePost">Duplicar</button>
            </div>
          </form>
        </main>
      </div>
    </section>

    <section id="tab-users" class="hidden">
      <div class="grid-2">
        <div class="card">
          <h2>Usuários admin</h2>
          <p class="muted">Em modo demo, usuários são locais. Com Supabase, esta lista reflete perfis/convites (cadastro via convite por e-mail).</p>
          <table>
            <thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th></th></tr></thead>
            <tbody id="usersBody"></tbody>
          </table>
        </div>
        <div class="card">
          <h2>Cadastrar usuário admin</h2>
          <div class="field"><label for="uNome">Nome</label><input type="text" id="uNome"></div>
          <div class="field"><label for="uEmail">E-mail</label><input type="email" id="uEmail"></div>
          <div class="field"><label for="uSenha">Senha</label><input type="password" id="uSenha" placeholder="Mín. 6 caracteres (demo)"></div>
          <div class="field"><label for="uPapel">Papel</label>
            <select id="uPapel"><option value="admin">admin</option><option value="editor">editor</option><option value="author">author</option></select>
          </div>
          <div class="bar">
            <button class="btn btn-primary" id="btnAddUser">Cadastrar usuário</button>
          </div>
          <div class="error" id="userError"></div>
          <div class="notice" style="margin-top:12px"><strong>Supabase:</strong> para convites reais por e-mail, use <code>supabase.auth.admin.inviteUserByEmail</code> em uma Edge Function com service role (não no navegador) e crie o registro em <code>blog.profiles</code>.</div>
        </div>
      </div>
    </section>

    <section id="tab-settings" class="hidden">
      <div class="grid-2">
        <div class="card">
          <h2>Configuração Supabase (produção)</h2>
          <p class="muted">Preencha para ativar autenticação e banco reais. Salvo no navegador deste dispositivo.</p>
          <div class="field"><label for="sbUrl">Project URL</label><input type="text" id="sbUrl" placeholder="https://xxxx.supabase.co"></div>
          <div class="field"><label for="sbKey">Publishable/Anon key</label><input type="text" id="sbKey" placeholder="sb_publishable_..."></div>
          <div class="bar">
            <button class="btn btn-primary" id="btnSaveSettings">Salvar configuração</button>
            <button class="btn" id="btnClearSettings">Usar modo demo</button>
          </div>
          <div class="muted" style="margin-top:8px">Nunca coloque service role no navegador. Este admin usa apenas a chave pública.</div>
        </div>
        <div class="card">
          <h2>Publicação / Deploy</h2>
          <p class="muted">Este site é estático (11ty). Posts salvos no Supabase/local não aparecem no site até o conteúdo ser convertido para Markdown em <code>src/posts/</code> e um novo build/deploy ocorrer.</p>
          <ul class="muted">
            <li>Exportar JSON das postagens e gerar arquivos <code>.md</code> em <code>src/posts/</code>.</li>
            <li>Commit e push no repositório <code>aguinaldool/bloguremar</code>.</li>
            <li>Vercel reconstrói automaticamente (ou via Deploy Hook).</li>
          </ul>
          <div class="bar"><button class="btn" id="btnResetDemo">Restaurar posts demo</button></div>
        </div>
      </div>
    </section>
  </div>
</div>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  var POSTS_KEY='ure_blog_posts_v2';
  var USERS_KEY='ure_blog_users_v1';
  var SESSION_KEY='ure_blog_session_v1';
  var CFG_KEY='ure_blog_cfg_v1';
  var sb=null, session=null, mode='demo';

  function uid(){ return 'id_'+Math.random().toString(36).slice(2,10)+Date.now().toString(36); }
  function slugify(s){ return (s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''); }
  function esc(s){ return String(s||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function toast(msg){ var t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(function(){t.classList.remove('show');},2200); }
  function $(id){ return document.getElementById(id); }

  var seedPosts=[
    {id:uid(),title:'Mostra de Projetos de Vida reúne escolas da URE Marília',resumo:'Estudantes apresentam projetos de autonomia e protagonismo desenvolvidos ao longo do ano letivo.',categoria:'projeto',tags:['projetos-de-vida','estudantes','mostra'],destaque:true,data:'2026-10-20',autor:'Equipe de Comunicação',status:'published',conteudo:'A Mostra de Projetos de Vida aconteceu no último sábado e reuniu estudantes de diferentes escolas da rede estadual de Marília.'},
    {id:uid(),title:'Avaliação formativa na prática: inscrições abertas',resumo:'Formação para professores da rede sobre estratégias de avaliação formativa em sala de aula.',categoria:'formacao',tags:['avaliacao','formacao','professores'],destaque:false,data:'2026-10-18',autor:'Núcleo de Formação',status:'published',conteudo:'Inscrições abertas para a formação "Avaliação formativa na prática".'},
    {id:uid(),title:'Orientações para o fechamento do 4º bimestre',resumo:'Calendário e procedimentos para encerramento do último bimestre do ano letivo.',categoria:'comunicado',tags:['bimestre','calendario','procedimentos'],destaque:false,data:'2026-10-15',autor:'Coordenação de Ensino',status:'published',conteudo:'A URE Marília divulgou as orientações para o fechamento do 4º bimestre.'},
    {id:uid(),title:'Guia de recomposição da aprendizagem — Língua Portuguesa',resumo:'Orientações para professores trabalharem a recomposição de conteúdos de Língua Portuguesa.',categoria:'material',tags:['recomposicao','lingua-portuguesa','guia','professores'],destaque:false,data:'2026-10-12',autor:'Núcleo de Formação',status:'published',conteudo:'Foi publicado o Guia de Recomposição da Aprendizagem em Língua Portuguesa.'},
    {id:uid(),title:'Encontro regional de leitura reúne professores da rede',resumo:'Evento discutiu práticas de incentivo à leitura em sala de aula e bibliotecas escolares.',categoria:'evento',tags:['leitura','encontro','professores','biblioteca'],destaque:false,data:'2026-10-09',autor:'Equipe de Comunicação',status:'published',conteudo:'Professores participaram do Encontro Regional de Leitura.'},
    {id:uid(),title:'Clube de leitura circula entre escolas de Marília e região',resumo:'Projeto leva encontros de leitura para diferentes escolas da rede estadual.',categoria:'projeto',tags:['clube-de-leitura','projeto','escolas'],destaque:false,data:'2026-10-05',autor:'Equipe de Comunicação',status:'published',conteudo:'O Clube de Leitura da URE Marília está circulando por escolas da rede estadual.'},
    {id:uid(),title:'Encontro de gestores e coordenadores pedagógicos',resumo:'Reunião mensal da URE com diretores e coordenadores das escolas da região.',categoria:'noticia',tags:['gestores','coordenadores','reuniao'],destaque:false,data:'2026-10-02',autor:'Coordenação de Ensino',status:'published',conteudo:'A URE Marília promoveu o encontro mensal de gestores e coordenadores pedagógicos.'},
    {id:uid(),title:'Acolhimento: o primeiro dia também ensina',resumo:'Reflexão sobre a importância do acolhimento de estudantes no início do ano letivo.',categoria:'noticia',tags:['acolhimento','inicio-do-ano','estudantes'],destaque:false,data:'2026-09-28',autor:'Equipe de Comunicação',status:'published',conteudo:'O primeiro dia de aula é mais do que entrega de materiais e organização de carteiras.'}
  ];

  function loadPosts(){ try{ var r=localStorage.getItem(POSTS_KEY); if(!r){ savePosts(seedPosts); return seedPosts.slice(); } return JSON.parse(r)||[]; }catch(e){ return seedPosts.slice(); } }
  function savePosts(p){ localStorage.setItem(POSTS_KEY, JSON.stringify(p)); }
  function loadUsers(){ try{ return JSON.parse(localStorage.getItem(USERS_KEY)||'[]'); }catch(e){ return []; } }
  function saveUsers(u){ localStorage.setItem(USERS_KEY, JSON.stringify(u)); }
  function loadCfg(){ try{ return JSON.parse(localStorage.getItem(CFG_KEY)||'{}'); }catch(e){ return {}; } }
  function saveCfg(c){ localStorage.setItem(CFG_KEY, JSON.stringify(c||{})); }

  var posts=loadPosts(), users=loadUsers(), currentPostId=null;

  function initSupabase(){
    var cfg=loadCfg();
    $('sbUrl').value=cfg.url||''; $('sbKey').value=cfg.key||'';
    if(cfg.url && cfg.key && window.supabase){ sb = window.supabase.createClient(cfg.url, cfg.key); mode='supabase'; $('modeLabel').textContent='Modo Supabase (configurado)'; $('appNotice').innerHTML='<strong>Supabase configurado.</strong> Login e dados usam o projeto informado. Aplique <code>supabase/migrations/001_initial.sql</code> e configure Auth/RLS.'; }
    else { sb=null; mode='demo'; $('modeLabel').textContent='Modo demonstração (local)'; }
  }

  function showApp(){ $('loginView').classList.add('hidden'); $('appView').classList.remove('hidden'); $('btnLogout').classList.remove('hidden'); renderPosts(); renderUsers(); }
  function showLogin(){ $('loginView').classList.remove('hidden'); $('appView').classList.add('hidden'); $('btnLogout').classList.add('hidden'); }

  async function doLogin(){
    $('loginError').textContent='';
    var email=$('loginEmail').value.trim(), pass=$('loginPass').value;
    if(mode==='supabase' && sb){
      var r = await sb.auth.signInWithPassword({email:email,password:pass});
      if(r.error){ $('loginError').textContent=r.error.message; return; }
      session=r.data.session; localStorage.setItem(SESSION_KEY, JSON.stringify({email:email,sb:true})); showApp(); toast('Login realizado.'); return;
    }
    var u=users.find(function(x){return x.email===email && x.senha===pass;});
    if(!u){ $('loginError').textContent='Usuário ou senha inválidos (modo demo). Cadastre um usuário ou use "Entrar em modo demo".'; return; }
    session={email:u.email,nome:u.nome,papel:u.papel,demo:true}; localStorage.setItem(SESSION_KEY, JSON.stringify(session)); showApp(); toast('Login realizado.');
  }

  $('btnLogin').onclick=doLogin;
  $('btnDemo').onclick=function(){ session={email:'demo@local',nome:'Admin Demo',papel:'admin',demo:true}; localStorage.setItem(SESSION_KEY, JSON.stringify(session)); showApp(); toast('Modo demo ativo.'); };
  $('btnLogout').onclick=async function(){ if(sb) await sb.auth.signOut(); localStorage.removeItem(SESSION_KEY); session=null; showLogin(); };

  // Tabs
  document.querySelectorAll('.tab').forEach(function(btn){
    btn.onclick=function(){
      document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      var t=btn.getAttribute('data-tab');
      ['posts','users','settings'].forEach(function(x){ $('tab-'+x).classList.toggle('hidden', x!==t); });
    };
  });

  // Posts
  function renderPosts(){
    var q=($('postSearch').value||'').toLowerCase();
    var list=$('postList'); list.innerHTML='';
    var filtered=posts.slice().sort(function(a,b){return (b.data||'').localeCompare(a.data||'');}).filter(function(p){
      if(!q) return true; return (p.title||'').toLowerCase().indexOf(q)!==-1 || (p.tags||[]).join(' ').toLowerCase().indexOf(q)!==-1;
    });
    filtered.forEach(function(p){
      var li=document.createElement('li'); li.className='item'+(p.id===currentPostId?' active':'');
      li.innerHTML='<div class="item-title">'+esc(p.title||'(sem título)')+'</div><div class="item-meta">'+esc(p.data||'')+' · '+esc(p.categoria||'')+' · <span class="pill '+(p.status==='draft'?'draft':'')+'">'+esc(p.status||'')+'</span></div>';
      li.onclick=function(){ selectPost(p.id); }; list.appendChild(li);
    });
    if(!filtered.length) list.innerHTML='<li class="muted">Nenhuma publicação.</li>';
    var tags={}; posts.forEach(function(p){(p.tags||[]).forEach(function(t){tags[t]=1;});});
    $('stPosts').textContent=posts.length; $('stPublished').textContent=posts.filter(function(p){return p.status==='published';}).length;
    $('stDrafts').textContent=posts.filter(function(p){return p.status==='draft';}).length; $('stTags').textContent=Object.keys(tags).length;
  }
  function selectPost(id){
    var p=posts.find(function(x){return x.id===id;}); if(!p) return; currentPostId=id;
    $('postId').value=p.id; $('title').value=p.title||''; $('resumo').value=p.resumo||''; $('categoria').value=p.categoria||'noticia';
    $('data').value=p.data||''; $('autor').value=p.autor||''; $('status').value=p.status||'published';
    $('tags').value=(p.tags||[]).join(', '); $('destaque').checked=!!p.destaque; $('conteudo').value=p.conteudo||'';
    $('postFormTitle').textContent='Editar postagem'; renderPosts();
  }
  function clearPost(){ currentPostId=null; $('postForm').reset(); $('postId').value=''; $('data').value=new Date().toISOString().slice(0,10); $('postFormTitle').textContent='Nova postagem'; renderPosts(); }
  $('btnNewPost').onclick=clearPost; $('postSearch').oninput=renderPosts;
  $('postForm').onsubmit=function(e){ e.preventDefault();
    var data={id:$('postId').value||uid(), title:$('title').value.trim(), resumo:$('resumo').value.trim(), categoria:$('categoria').value, data:$('data').value, autor:$('autor').value.trim(), status:$('status').value, tags:$('tags').value.split(',').map(function(s){return slugify(s.trim())||s.trim();}).filter(Boolean), destaque:$('destaque').checked, conteudo:$('conteudo').value, slug:slugify($('title').value)};
    if(!data.title){ toast('Informe um título.'); return; }
    var idx=posts.findIndex(function(p){return p.id===data.id;}); if(idx>=0) posts[idx]=Object.assign({},posts[idx],data); else posts.unshift(data);
    savePosts(posts); currentPostId=data.id; renderPosts(); selectPost(data.id); toast('Postagem salva.');
  };
  $('btnDeletePost').onclick=function(){ if(!currentPostId){toast('Selecione uma postagem.');return;} if(!confirm('Excluir esta postagem?')) return; posts=posts.filter(function(p){return p.id!==currentPostId;}); savePosts(posts); clearPost(); toast('Postagem excluída.'); };
  $('btnDuplicatePost').onclick=function(){ if(!currentPostId){toast('Selecione uma postagem.');return;} var p=posts.find(function(x){return x.id===currentPostId;}); if(!p) return; var c=JSON.parse(JSON.stringify(p)); c.id=uid(); c.title=p.title+' (cópia)'; c.slug=slugify(c.title); c.status='draft'; posts.unshift(c); savePosts(posts); renderPosts(); selectPost(c.id); toast('Postagem duplicada.'); };

  $('btnExport').onclick=function(){ var blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),posts:posts},null,2)],{type:'application/json'}); var a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='blog-ure-posts.json'; a.click(); setTimeout(function(){URL.revokeObjectURL(a.href);},1000); toast('JSON exportado.'); };
  $('btnImport').onclick=function(){ $('fileInput').click(); };
  $('fileInput').onchange=function(e){ var f=e.target.files[0]; if(!f) return; var r=new FileReader(); r.onload=function(){ try{ var d=JSON.parse(r.result); var arr=Array.isArray(d)?d:(d.posts||[]); if(!arr.length){toast('Nenhuma publicação.');return;} posts=arr.map(function(p){p.id=p.id||uid(); p.tags=p.tags||[]; return p;}); savePosts(posts); clearPost(); toast('Importado.'); }catch(err){ toast('Arquivo inválido.'); } }; r.readAsText(f); e.target.value=''; };
  $('btnResetDemo').onclick=function(){ if(!confirm('Restaurar posts de demonstração?')) return; posts=JSON.parse(JSON.stringify(seedPosts)); posts.forEach(function(p){p.id=uid();}); savePosts(posts); clearPost(); toast('Demo restaurada.'); };

  // Users
  function renderUsers(){
    var tbody=$('usersBody'); tbody.innerHTML='';
    if(!users.length){ tbody.innerHTML='<tr><td colspan="4" class="muted">Nenhum usuário cadastrado (demo). Cadastre ao lado.</td></tr>'; return; }
    users.forEach(function(u,idx){
      var tr=document.createElement('tr');
      tr.innerHTML='<td>'+esc(u.nome||'-')+'</td><td>'+esc(u.email)+'</td><td><span class="pill '+(u.papel==='admin'?'admin':'')+'">'+esc(u.papel)+'</span></td><td><button class="btn btn-sm btn-danger" data-i="'+idx+'">Remover</button></td>';
      tbody.appendChild(tr);
    });
    tbody.querySelectorAll('button[data-i]').forEach(function(b){ b.onclick=function(){ var i=parseInt(b.getAttribute('data-i'),10); users.splice(i,1); saveUsers(users); renderUsers(); toast('Usuário removido.'); }; });
  }
  $('btnAddUser').onclick=function(){
    $('userError').textContent='';
    var nome=$('uNome').value.trim(), email=$('uEmail').value.trim().toLowerCase(), senha=$('uSenha').value, papel=$('uPapel').value;
    if(!email || !senha){ $('userError').textContent='Informe e-mail e senha.'; return; }
    if(senha.length<6){ $('userError').textContent='Senha deve ter ao menos 6 caracteres.'; return; }
    if(users.some(function(u){return u.email===email;})){ $('userError').textContent='Já existe usuário com este e-mail.'; return; }
    users.push({id:uid(), nome:nome, email:email, senha:senha, papel:papel, criadoEm:new Date().toISOString()});
    saveUsers(users); $('uNome').value=''; $('uEmail').value=''; $('uSenha').value=''; renderUsers(); toast('Usuário cadastrado.');
  };

  // Settings
  $('btnSaveSettings').onclick=function(){ saveCfg({url:$('sbUrl').value.trim(), key:$('sbKey').value.trim()}); initSupabase(); toast('Configuração salva.'); };
  $('btnClearSettings').onclick=function(){ saveCfg({}); initSupabase(); toast('Modo demo ativo.'); };

  // Boot
  initSupabase();
  try{ session=JSON.parse(localStorage.getItem(SESSION_KEY)||'null'); }catch(e){ session=null; }
  if(session) showApp(); else showLogin();
  clearPost(); renderPosts(); renderUsers();
})();
</script>
</body>
</html>
