permalink: /admin/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Admin — URE Marília</title>
<style>
:root{--bg:#F5F8FC;--surface:#fff;--line:#D7E0EA;--ink:#0E1F35;--muted:#7A8FA8;--blue:#2563EB;--teal:#0D9488;--amber:#D97706;--red:#DC2626;--radius:14px;--font:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;--mono:ui-monospace,Consolas,monospace}
*{box-sizing:border-box}body{margin:0;font-family:var(--font);background:var(--bg);color:var(--ink);line-height:1.5}
a{color:var(--blue)}button,input,select,textarea{font:inherit}
.hidden{display:none!important}.muted{color:var(--muted);font-size:13px}
.wrap{max-width:1200px;margin:0 auto;padding:20px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:22px;margin:0}h2{font-size:16px;margin:0 0 10px}h3{font-size:14px;margin:0 0 8px}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;font-weight:600;font-size:13px}
.btn:hover{border-color:#94a3b8}.btn-primary{background:var(--blue);color:#fff;border-color:var(--blue)}.btn-danger{color:var(--red);border-color:#fecaca}.btn-sm{padding:6px 10px;font-size:12px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:14px}
.grid{display:grid;grid-template-columns:320px 1fr;gap:16px}@media(max-width:950px){.grid{grid-template-columns:1fr}}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:700px){.grid-2{grid-template-columns:1fr}}
.field{margin-bottom:12px}.field label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em}
.field input[type=text],.field input[type=email],.field input[type=password],.field input[type=date],.field input[type=color],.field select,.field textarea{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:#fff}
.field textarea{min-height:200px;font-family:var(--mono);font-size:13px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:700px){.row{grid-template-columns:1fr}}
.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;max-height:65vh;overflow:auto}
.item{border:1px solid var(--line);border-radius:10px;padding:10px;cursor:pointer}.item:hover{border-color:#94a3b8}.item.active{border-color:var(--blue);background:#f8fbff}
.item-title{font-weight:700;font-size:14px;margin:0 0 4px}.item-meta{font-size:12px;color:var(--muted)}
.pill{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:#eef2ff;color:var(--blue);font-weight:700}
.pill.draft{background:#fef3c7;color:#92400e}.pill.admin{background:#ede9fe;color:#5b21b6}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.tab{padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:var(--surface);cursor:pointer;font-weight:600;font-size:13px}
.tab.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.notice{font-size:13px;color:var(--muted);background:#fff;border:1px dashed var(--line);border-radius:10px;padding:10px 12px;margin-bottom:14px}
.stats{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}.stat{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px;min-width:120px}
.stat b{display:block;font-size:20px}.stat span{font-size:12px;color:var(--muted)}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line);font-size:13px}th{font-size:12px;color:var(--muted);text-transform:uppercase}
.toast{position:fixed;right:16px;bottom:16px;background:#0E1F35;color:#fff;padding:10px 14px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;z-index:50}
.toast.show{opacity:1;transform:none}
.anexo-list-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:#fafbfc}
.anexo-list-item .anexo-icon{font-size:18px;flex-shrink:0}
.anexo-list-item .anexo-info{flex:1;min-width:0}
.anexo-list-item .anexo-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.anexo-list-item .anexo-size{font-size:11px;color:var(--muted)}
.anexo-list-item .anexo-remove{background:none;border:none;color:var(--red);cursor:pointer;font-size:16px;padding:4px}
.anexo-list-item .anexo-remove:hover{opacity:.7}
.login{max-width:420px;margin:50px auto}
.error{color:var(--red);font-size:13px;margin-top:6px}
.search input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:10px}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div>
      <h1>Admin — Caderno da Rede</h1>
      <div class="muted" id="userLabel">URE Marília</div>
    </div>
    <div class="bar">
      <a class="btn btn-sm" href="/" target="_blank">Ver site</a>
      <button class="btn btn-sm hidden" id="btnLogout">Sair</button>
    </div>
  </div>

  <div id="loginView" class="login card hidden">
    <h2>Entrar</h2>
    <p class="muted">Use seu e-mail e senha de administrador da URE Marília.</p>
    <div class="field"><label for="loginEmail">E-mail</label><input type="email" id="loginEmail" autocomplete="username"></div>
    <div class="field"><label for="loginPass">Senha</label><input type="password" id="loginPass" autocomplete="current-password"></div>
    <div class="bar">
      <button class="btn btn-primary" id="btnLogin">Entrar</button>
    </div>
    <div class="error" id="loginError"></div>
  </div>

  <div id="appView" class="hidden">
    <div class="tabs">
      <button class="tab active" data-tab="posts">Postagens</button>
      <button class="tab" data-tab="tags">Tags</button>
      <button class="tab" data-tab="users">Usuários</button>
    </div>

    <section id="tab-posts">
      <div class="stats">
        <div class="stat"><b id="stPosts">0</b><span>publicações</span></div>
        <div class="stat"><b id="stPublished">0</b><span>publicadas</span></div>
        <div class="stat"><b id="stDrafts">0</b><span>rascunhos</span></div>
        <div class="stat"><b id="stTags">0</b><span>tags únicas</span></div>
      </div>
      <div class="grid">
        <aside class="card">
          <h2>Postagens</h2>
          <div class="search"><input type="text" id="postSearch" placeholder="Buscar por título ou tag"></div>
          <div class="bar" style="margin-bottom:10px">
            <button class="btn btn-primary btn-sm" id="btnNewPost">Nova postagem</button>
            <button class="btn btn-sm" id="btnExport">Exportar JSON</button>
            <button class="btn btn-sm" id="btnImport">Importar</button>
            <input type="file" id="fileInput" accept="application/json" class="hidden">
          </div>
          <ul class="list" id="postList"></ul>
        </aside>
        <main class="card">
          <h2 id="postFormTitle">Nova postagem</h2>
          <form id="postForm">
            <input type="hidden" id="postId">
            <input type="hidden" id="postSlug">
            <div class="field"><label for="title">Título</label><input type="text" id="title" required></div>
            <div class="field"><label for="resumo">Resumo</label><input type="text" id="resumo"></div>
            <div class="row">
              <div class="field"><label for="categoria">Categoria</label>
                <select id="categoria"><option value="noticia">Notícia</option><option value="comunicado">Comunicado</option><option value="formacao">Formação</option><option value="material">Material</option><option value="projeto">Projeto</option><option value="evento">Evento</option></select>
              </div>
              <div class="field"><label for="data">Data</label><input type="date" id="data"></div>
            </div>
            <div class="row">
              <div class="field"><label for="autor">Autor</label><input type="text" id="autor" value="Equipe URE Marília"></div>
              <div class="field"><label for="status">Status</label>
                <select id="status"><option value="published">Publicado</option><option value="draft">Rascunho</option><option value="review">Em revisão</option><option value="archived">Arquivado</option></select>
              </div>
            </div>
            <div class="field"><label for="tags">Tags (vírgula)</label><input type="text" id="tags" placeholder="ex: leitura, professores"></div>
            <div class="field"><label><input type="checkbox" id="destaque"> Destaque na página inicial</label></div>
            <div class="field"><label for="conteudo">Conteúdo (Markdown)</label><textarea id="conteudo"></textarea></div>
            
            <!-- Anexos (Google Drive) -->
            <div class="field">
              <label>Anexos</label>
              <div class="notice">Arquivos anexados serão salvos no Google Drive e ficam públicos para download.</div>
              <div class="bar" style="margin-bottom:10px">
                <button type="button" class="btn btn-sm" id="btnAddAnexo">📎 Adicionar arquivo</button>
                <input type="file" id="anexoInput" multiple class="hidden" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip,.rar,.png,.jpg,.jpeg,.gif">
                <span class="muted" id="anexoHelp">PDF, DOC, XLS, imagens, etc. (máx 50MB por arquivo)</span>
              </div>
              <div id="anexoProgress" class="hidden" style="margin-bottom:10px">
                <div style="background:var(--line);border-radius:6px;height:6px;overflow:hidden">
                  <div id="anexoProgressBar" style="background:var(--blue);height:100%;width:0%;transition:width .3s"></div>
                </div>
                <div class="muted" id="anexoProgressText" style="font-size:12px;margin-top:4px">Enviando...</div>
              </div>
              <ul id="anexoList" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px"></ul>
            </div>

            <div class="bar">
              <button type="submit" class="btn btn-primary" id="btnSavePost">Salvar postagem</button>
              <button type="button" class="btn btn-danger" id="btnDeletePost">Excluir</button>
              <button type="button" class="btn" id="btnDuplicatePost">Duplicar</button>
            </div>
            <div class="error" id="postError"></div>
          </form>
        </main>
      </div>
    </section>

    <section id="tab-tags" class="hidden">
      <div class="grid-2">
        <div class="card">
          <h2>Tags existentes</h2>
          <p class="muted">Gerencie as tags utilizadas nas postagens do blog.</p>
          <div class="search"><input type="text" id="tagSearch" placeholder="Buscar tag..."></div>
          <ul class="list" id="tagList"></ul>
        </div>
        <div class="card">
          <h2 id="tagFormTitle">Nova tag</h2>
          <div class="field"><label for="tagName">Nome da tag</label><input type="text" id="tagName" placeholder="ex: Formação de Professores"></div>
          <div class="field"><label for="tagSlug">Slug</label><input type="text" id="tagSlug" placeholder="gerado automaticamente" class="muted"></div>
          <div class="field"><label for="tagCor">Cor</label><input type="text" id="tagCor" value="#2563EB" style="width:120px"></div>
          <div class="notice">A cor é usada na nuvem de tags e nos filtros do site.</div>
          <div class="bar">
            <button class="btn btn-primary" id="btnSaveTag">Salvar tag</button>
            <button class="btn btn-danger" id="btnDeleteTag">Excluir</button>
            <button class="btn" id="btnNewTag">Nova tag</button>
          </div>
          <div class="error" id="tagError"></div>
          <hr style="margin:20px 0;border:none;border-top:1px solid var(--line)">
          <h3>Operações em lote</h3>
          <p class="muted">Renomear ou mesclar tags em todas as postagens.</p>
          <div class="row">
            <div class="field"><label for="mergeFrom">Tag origem</label>
              <select id="mergeFrom"></select>
            </div>
            <div class="field"><label for="mergeTo">Renomear para</label><input type="text" id="mergeTo" placeholder="novo nome"></div>
          </div>
          <div class="bar">
            <button class="btn btn-primary btn-sm" id="btnRenameTag">Renomear em todos os posts</button>
          </div>
          <div class="error" id="mergeError"></div>
        </div>
      </div>
    </section>

    <section id="tab-users" class="hidden">
      <div class="grid-2">
        <div class="card">
          <h2>Usuários cadastrados</h2>
          <p class="muted">Gerencie os usuários com acesso ao painel administrativo.</p>
          <table>
            <thead><tr><th>Nome</th><th>E-mail</th><th>Papel</th><th></th></tr></thead>
            <tbody id="usersBody"></tbody>
          </table>
        </div>
        <div class="card">
          <h2>Cadastrar usuário</h2>
          <div class="field"><label for="uNome">Nome</label><input type="text" id="uNome"></div>
          <div class="field"><label for="uEmail">E-mail</label><input type="email" id="uEmail"></div>
          <div class="field"><label for="uSenha">Senha</label><input type="password" id="uSenha" placeholder="Mín. 6 caracteres"></div>
          <div class="field"><label for="uPapel">Papel</label>
            <select id="uPapel"><option value="admin">admin</option><option value="editor">editor</option><option value="author">author</option></select>
          </div>
          <div class="bar"><button class="btn btn-primary" id="btnAddUser">Cadastrar usuário</button></div>
          <div class="error" id="userError"></div>
        </div>
      </div>
    </section>
  </div>
</div>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
  "use strict";
  var SUPABASE_URL = "https://lymrixekprobknxvoomk.supabase.co";
  var SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx5bXJpeGVrcHJvYmtueHZvb21rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ4NDM1MjcsImV4cCI6MjExMDQxOTUyN30.ZK0wp4o2XZwJ98a6EdPzKe85fTA1S3G9ex2SmsgBcbw";
  var sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  var session = null, posts = [], users = [], currentPostId = null;

  function $(id){ return document.getElementById(id); }
  function toast(msg){ var t=$("toast"); t.textContent=msg; t.classList.add("show"); setTimeout(function(){ t.classList.remove("show"); },2600); }
  function esc(s){ return String(s||"").replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
  function slugify(s){ return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/(^-|-$)/g,""); }
  function uidUUID(){ return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g,function(c){var r=Math.random()*16|0,v=c==="x"?r:(r&0x3|0x8);return v.toString(16);}); }
  function userId(){ return (session && session.user && session.user.id) || null; }
  function userEmail(){ return (session && session.user && session.user.email) || ""; }

  function showLogin(){
    $("loginView").classList.remove("hidden");
    $("appView").classList.add("hidden");
    $("btnLogout").classList.add("hidden");
    $("userLabel").textContent = "URE Marília";
  }
  function showApp(){
    $("appView").classList.remove("hidden");
    $("loginView").classList.add("hidden");
    $("btnLogout").classList.remove("hidden");
    $("userLabel").textContent = userEmail() || "URE Marília";
    clearPost();
    refreshPosts();
    refreshTags();
    refreshUsers();
  }

  function uniqueSlug(baseSlug, postId){
    var s = baseSlug || ("post-" + Date.now().toString(36));
    var clash = posts.some(function(p){ return p.slug === s && p.id !== postId; });
    if(clash) s = s + "-" + Math.random().toString(36).slice(2,6);
    return s;
  }

  function postToPayload(p){
    var dateStr = p.data || new Date().toISOString().slice(0,10);
    return {
      id: p.id,
      titulo: p.title||"",
      resumo: p.resumo||"",
      categoria: p.categoria||"noticia",
      tipo: p.categoria||"noticia",
      tags: p.tags||[],
      anexos: p.anexos||[],
      destaque: !!p.destaque,
      publicado_em: dateStr + "T12:00:00Z",
      autor: p.autor||"Equipe URE Marília",
      autor_id: userId(),
      status: p.status||"published",
      conteudo: p.conteudo||"",
      slug: uniqueSlug(p.slug || slugify(p.title||""), p.id)
    };
  }
  function payloadToPost(r){
    return {
      id: r.id, title: r.titulo, resumo: r.resumo, categoria: r.categoria||r.tipo,
      tags: r.tags||[], anexos: r.anexos||[], destaque: !!r.destaque, data: (r.publicado_em||"").slice(0,10),
      autor: r.autor||"", status: r.status||"draft", conteudo: r.conteudo||"", slug: r.slug||""
    };
  }

  async function refreshPosts(){
    try{
      var r = await sb.schema("blog").from("posts").select("*").order("publicado_em",{ascending:false});
      if(r.error) throw r.error;
      posts = (r.data||[]).map(payloadToPost);
    }catch(e){ toast("Erro ao carregar postagens: "+e.message); posts=[]; }
    renderPosts();
  }
  function renderPosts(){
    var q = ($("postSearch").value||"").toLowerCase();
    var list = $("postList"); list.innerHTML = "";
    var filtered = posts.slice().sort(function(a,b){return (b.data||"").localeCompare(a.data||"");}).filter(function(p){
      if(!q) return true;
      return (p.title||"").toLowerCase().indexOf(q)!==-1 || (p.tags||[]).join(" ").toLowerCase().indexOf(q)!==-1;
    });
    filtered.forEach(function(p){
      var li=document.createElement("li"); li.className="item"+(p.id===currentPostId?" active":"");
      li.innerHTML='<div class="item-title">'+esc(p.title||"(sem título)")+'</div><div class="item-meta">'+esc(p.data||"")+" · "+esc(p.categoria||"")+' · <span class="pill '+(p.status==="draft"?"draft":"")+'">'+esc(p.status||"")+"</span></div>";
      li.onclick=function(){ selectPost(p.id); }; list.appendChild(li);
    });
    if(!filtered.length) list.innerHTML='<li class="muted">Nenhuma publicação.</li>';
    var tags={}; posts.forEach(function(p){(p.tags||[]).forEach(function(t){tags[t]=1;});});
    $("stPosts").textContent=posts.length;
    $("stPublished").textContent=posts.filter(function(p){return p.status==="published";}).length;
    $("stDrafts").textContent=posts.filter(function(p){return p.status==="draft";}).length;
    $("stTags").textContent=Object.keys(tags).length;
  }
  function selectPost(id){
    var p=posts.find(function(x){return x.id===id;}); if(!p) return; currentPostId=id;
    $("postError").textContent="";
    $("postId").value=p.id; $("postSlug").value=p.slug||""; $("title").value=p.title||""; $("resumo").value=p.resumo||""; $("categoria").value=p.categoria||"noticia";
    $("data").value=p.data||""; $("autor").value=p.autor||"Equipe URE Marília"; $("status").value=p.status||"published";
    $("tags").value=(p.tags||[]).join(", "); $("destaque").checked=!!p.destaque; $("conteudo").value=p.conteudo||"";
    anexos = (p.anexos||[]).slice(); renderAnexos();
    $("postFormTitle").textContent="Editar postagem"; renderPosts();
  }
  function clearPost(){
    currentPostId=null;
    $("postError").textContent="";
    $("postForm").reset();
    $("postId").value="";
    $("postSlug").value="";
    $("autor").value="Equipe URE Marília";
    $("status").value="published";
    $("data").value=new Date().toISOString().slice(0,10);
    anexos = []; renderAnexos();
    $("postFormTitle").textContent="Nova postagem";
    renderPosts();
  }
  $("btnNewPost").onclick=clearPost;
  $("postSearch").oninput=renderPosts;

  $("postForm").onsubmit=async function(e){
    e.preventDefault();
    $("postError").textContent="";
    var isNew = !$("postId").value;
    var id = $("postId").value || uidUUID();
    var title = $("title").value.trim();
    if(!title){ $("postError").textContent="Informe um título."; return; }
    var d={
      id: id,
      title: title,
      resumo: $("resumo").value.trim(),
      categoria: $("categoria").value,
      data: $("data").value,
      autor: $("autor").value.trim() || "Equipe URE Marília",
      status: $("status").value,
      tags: $("tags").value.split(",").map(function(s){return slugify(s.trim())||s.trim();}).filter(Boolean),
      anexos: anexos.slice(),
      destaque: $("destaque").checked,
      conteudo: $("conteudo").value,
      slug: (!isNew && $("postSlug").value) ? $("postSlug").value : slugify(title)
    };
    $("btnSavePost").disabled = true;
    try{
      var r = await sb.schema("blog").from("posts").upsert(postToPayload(d),{onConflict:"id"});
      if(r.error){ $("postError").textContent="Erro ao salvar: "+r.error.message; toast("Erro ao salvar: "+r.error.message); return; }
      currentPostId = d.id;
      await refreshPosts();
      selectPost(d.id);
      toast("Postagem salva com sucesso! O site será atualizado em ~1 min.");
      await refreshTags();
    }catch(err){
      $("postError").textContent="Erro: "+err.message;
      toast("Erro: "+err.message);
    }finally{
      $("btnSavePost").disabled = false;
    }
  };
  $("btnDeletePost").onclick=async function(){
    if(!currentPostId){ toast("Selecione uma postagem."); return; }
    if(!confirm("Excluir esta postagem?")) return;
    try{
      var r=await sb.schema("blog").from("posts").delete().eq("id",currentPostId);
      if(r.error){ toast("Erro: "+r.error.message); return; }
      await refreshPosts(); clearPost(); refreshTags(); toast("Postagem excluída.");
    }catch(err){ toast("Erro: "+err.message); }
  };
  $("btnDuplicatePost").onclick=async function(){
    if(!currentPostId){ toast("Selecione uma postagem."); return; }
    var p=posts.find(function(x){return x.id===currentPostId;}); if(!p) return;
    var c=JSON.parse(JSON.stringify(p)); c.id=uidUUID(); c.title=p.title+" (cópia)"; c.slug=slugify(c.title); c.status="draft";
    try{
      var r=await sb.schema("blog").from("posts").upsert(postToPayload(c),{onConflict:"id"});
      if(r.error){ toast("Erro: "+r.error.message); return; }
      await refreshPosts(); selectPost(c.id); toast("Postagem duplicada.");
    }catch(err){ toast("Erro: "+err.message); }
  };
  $("btnExport").onclick=function(){ var blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),posts:posts},null,2)],{type:"application/json"}); var a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download="blog-ure-posts.json"; a.click(); setTimeout(function(){URL.revokeObjectURL(a.href);},1000); toast("JSON exportado."); };
  $("btnImport").onclick=function(){ $("fileInput").click(); };
  $("fileInput").onchange=function(e){ var f=e.target.files[0]; if(!f) return; var r=new FileReader(); r.onload=function(){ try{ var d=JSON.parse(r.result); var arr=Array.isArray(d)?d:(d.posts||[]); if(!arr.length){toast("Nenhuma publicação.");return;} posts=arr.map(function(p){p.id=p.id||uidUUID(); p.tags=p.tags||[]; return p;}); renderPosts(); toast("Importado. Salve cada postagem para gravar no banco."); }catch(err){ toast("Arquivo inválido."); } }; r.readAsText(f); e.target.value=""; };

  // ========================================
  // Anexos (Google Drive via Apps Script)
  // ========================================
  var anexos = []; // Array de {id, nome, tamanho, tipo, url, driveId}
  
  // ⚠️ COLE AQUI A URL DO GOOGLE APPS SCRIPT DEPLOYADO
  // Exemplo: "https://script.google.com/macros/s/AKfycbz..."
  var APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwqOP-aG88nd0SvTwd03OEL78p7OpN8y3AnVOE5RTes0PdRxGNLLYo7WuYcRgo9Sj9G/exec"; 

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + " B";
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
    return (bytes / (1024 * 1024)).toFixed(1) + " MB";
  }

  function getFileIcon(tipo) {
    if (!tipo) return "📄";
    if (tipo.indexOf("pdf") !== -1) return "📕";
    if (tipo.indexOf("image") !== -1) return "🖼️";
    if (tipo.indexOf("word") !== -1 || tipo.indexOf("document") !== -1) return "📘";
    if (tipo.indexOf("sheet") !== -1 || tipo.indexOf("excel") !== -1) return "📗";
    if (tipo.indexOf("presentation") !== -1 || tipo.indexOf("powerpoint") !== -1) return "📙";
    if (tipo.indexOf("zip") !== -1 || tipo.indexOf("rar") !== -1) return "📦";
    if (tipo.indexOf("text") !== -1) return "📝";
    return "📄";
  }

  function renderAnexos() {
    var list = $("anexoList");
    list.innerHTML = "";
    if (!anexos.length) {
      list.innerHTML = '<li class="muted" style="padding:8px">Nenhum anexo adicionado.</li>';
      return;
    }
    anexos.forEach(function(a, idx) {
      var li = document.createElement("li");
      li.className = "anexo-list-item";
      li.innerHTML = '<span class="anexo-icon">' + getFileIcon(a.tipo) + '</span>' +
        '<div class="anexo-info">' +
        '<div class="anexo-name">' + esc(a.nome) + '</div>' +
        '<div class="anexo-size">' + formatFileSize(a.tamanho) + '</div>' +
        '</div>' +
        '<button type="button" class="anexo-remove" data-idx="' + idx + '" title="Remover anexo">✕</button>';
      list.appendChild(li);
    });
    // Bind remove buttons
    list.querySelectorAll(".anexo-remove").forEach(function(btn) {
      btn.onclick = function() {
        var idx = parseInt(this.getAttribute("data-idx"), 10);
        if (confirm("Remover o anexo \"" + anexos[idx].nome + "\"?")) {
          anexos.splice(idx, 1);
          renderAnexos();
        }
      };
    });
  }

  // Converte File para base64
  function fileToBase64(file) {
    return new Promise(function(resolve, reject) {
      var reader = new FileReader();
      reader.onload = function() {
        // Remove o prefixo "data:..." do resultado
        var base64 = reader.result.split(',')[1];
        resolve(base64);
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function uploadAnexo(file) {
    if (!APPS_SCRIPT_URL) {
      toast("⚠️ URL do Apps Script não configurada. Peça ao administrador.");
      throw new Error("URL do Apps Script não configurada");
    }

    $("anexoProgress").classList.remove("hidden");
    $("anexoProgressBar").style.width = "20%";
    $("anexoProgressText").textContent = "Preparando " + file.name + "...";

    try {
      // Converte arquivo para base64
      $("anexoProgressBar").style.width = "40%";
      var base64 = await fileToBase64(file);
      
      $("anexoProgressBar").style.width = "60%";
      $("anexoProgressText").textContent = "Enviando " + file.name + "...";

      // Envia para o Google Apps Script
      var response = await fetch(APPS_SCRIPT_URL, {
        method: "POST",
        body: JSON.stringify({
          file: base64,
          fileName: file.name,
          fileType: file.type,
          fileSize: file.size
        })
      });

      $("anexoProgressBar").style.width = "90%";

      var result = await response.json();

      if (!response.ok || result.error) {
        throw new Error(result.error || "Erro no upload");
      }

      $("anexoProgressBar").style.width = "100%";
      $("anexoProgressText").textContent = "Enviado com sucesso!";

      if (result.success && result.anexo) {
        anexos.push(result.anexo);
        renderAnexos();
        toast("Anexo adicionado: " + file.name);
      }

      setTimeout(function() {
        $("anexoProgress").classList.add("hidden");
      }, 1500);

    } catch (error) {
      $("anexoProgress").classList.add("hidden");
      toast("Erro ao enviar: " + error.message);
      throw error;
    }
  }

  $("btnAddAnexo").onclick = function() {
    if (!APPS_SCRIPT_URL) {
      alert("⚠️ URL do Google Apps Script não configurada.\n\nPeça ao administrador para configurar em src/admin/index.njk\n(variável APPS_SCRIPT_URL)");
      return;
    }
    $("anexoInput").click();
  };

  $("anexoInput").onchange = async function(e) {
    var files = Array.from(e.target.files || []);
    if (!files.length) return;

    for (var i = 0; i < files.length; i++) {
      try {
        await uploadAnexo(files[i]);
      } catch (err) {
        console.error("Erro no arquivo " + files[i].name + ":", err);
      }
    }
    
    // Reset input
    e.target.value = "";
  };

  // Inicializa lista vazia
  renderAnexos();

  // ========================================
  // Gerenciamento de Tags (escopo admin)
  // ========================================
  var tags = []; // {slug, name, cor, count}
  var currentTagSlug = null;

  function collectTags(){
    var map = {};
    posts.forEach(function(p){
      (p.tags||[]).forEach(function(t){
        var s = slugify(t) || t.trim();
        if(!s) return;
        if(!map[s]) map[s] = {slug: s, name: t.trim(), cor: "#2563EB", count: 0};
        map[s].count++;
      });
    });
    return Object.values(map).sort(function(a,b){ return b.count - a.count || a.name.localeCompare(b.name); });
  }

  async function refreshTags(){
    tags = collectTags();
    // Tenta carregar cores personalizadas da tabela categories (se existir como tags)
    try{
      var r = await sb.schema("blog").from("categories").select("slug,cor");
      if(!r.error && r.data){
        var corMap = {};
        r.data.forEach(function(c){ corMap[c.slug] = c.cor; });
        tags.forEach(function(t){ if(corMap[t.slug]) t.cor = corMap[t.slug]; });
      }
    }catch(e){/* categorias podem não existir ainda */}
    renderTags();
  }

  function renderTags(){
    var q = ($("tagSearch").value||"").toLowerCase();
    var list = $("tagList"); list.innerHTML = "";
    var filtered = tags.filter(function(t){
      if(!q) return true;
      return t.name.toLowerCase().indexOf(q)!==-1 || t.slug.toLowerCase().indexOf(q)!==-1;
    });
    if(!filtered.length){ list.innerHTML='<li class="muted">Nenhuma tag encontrada.</li>'; }
    filtered.forEach(function(t){
      var li=document.createElement("li"); li.className="item"+(t.slug===currentTagSlug?" active":"");
      li.innerHTML='<div style="display:flex;align-items:center;gap:8px">'+
        '<span style="width:12px;height:12px;border-radius:50%;background:'+esc(t.cor)+';flex-shrink:0"></span>'+
        '<div style="flex:1"><div class="item-title">'+esc(t.name)+'</div>'+
        '<div class="item-meta">'+esc(t.slug)+' · '+t.count+' post'+(t.count!==1?'s':'')+'</div></div></div>';
      li.onclick=function(){ selectTag(t.slug); };
      list.appendChild(li);
    });
    // Atualiza também o select de merge
    var sel = $("mergeFrom"); if(sel){
      sel.innerHTML = '<option value="">-- selecione --</option>';
      tags.forEach(function(t){
        var opt = document.createElement("option");
        opt.value = t.slug; opt.textContent = t.name + ' ('+t.count+')';
        sel.appendChild(opt);
      });
    }
  }

  function selectTag(slug){
    var t = tags.find(function(x){return x.slug===slug;});
    if(!t) return;
    currentTagSlug = slug;
    $("tagName").value = t.name;
    $("tagSlug").value = t.slug;
    $("tagCor").value = t.cor || "#2563EB";
    $("tagFormTitle").textContent = "Editar tag: " + t.name;
    $("tagError").textContent = "";
    renderTags();
  }

  function clearTag(){
    currentTagSlug = null;
    $("tagName").value = "";
    $("tagSlug").value = "";
    $("tagCor").value = "#2563EB";
    $("tagFormTitle").textContent = "Nova tag";
    $("tagError").textContent = "";
    renderTags();
  }

  $("tagSearch").oninput = renderTags;
  $("btnNewTag").onclick = clearTag;

  // Auto-gera slug a partir do nome
  $("tagName").addEventListener("input", function(){
    $("tagSlug").value = slugify(this.value);
  });

  $("btnSaveTag").onclick = async function(){
    $("tagError").textContent = "";
    var name = $("tagName").value.trim();
    var slug = slugify(name);
    var cor = $("tagCor").value || "#2563EB";
    if(!name){ $("tagError").textContent = "Informe um nome para a tag."; return; }

    // Salva cor na tabela categories (se disponível)
    try{
      await sb.schema("blog").from("categories").upsert({
        nome: name,
        slug: slug,
        cor: cor
      }, {onConflict: "slug"});
    }catch(e){/* ok se categories não existir */}

    // Se renomeando uma tag existente, atualiza todos os posts
    if(currentTagSlug && currentTagSlug !== slug){
      await renameTagInPosts(currentTagSlug, name, slug);
    }

    await refreshPosts();
    await refreshTags();
    clearTag();
    toast("Tag salva com sucesso!");
  };

  $("btnDeleteTag").onclick = async function(){
    if(!currentTagSlug){ toast("Selecione uma tag para excluir."); return; }
    var t = tags.find(function(x){return x.slug===currentTagSlug;});
    if(!t){ return; }
    if(!confirm("Remover a tag \""+t.name+"\" de todos os "+t.count+" post(s)?")) return;
    $("tagError").textContent = "";
    try{
      await removeTagFromPosts(currentTagSlug);
      // Remove da tabela categories também
      try{
        await sb.schema("blog").from("categories").delete().eq("slug", currentTagSlug);
      }catch(e){}
      await refreshPosts();
      await refreshTags();
      clearTag();
      toast("Tag excluída.");
    }catch(err){
      $("tagError").textContent = "Erro: "+err.message;
      toast("Erro: "+err.message);
    }
  };

  async function renameTagInPosts(oldSlug, newName, newSlug){
    // Busca posts que contêm a tag antiga
    var r = await sb.schema("blog").from("posts").select("id,tags").contains("tags", [oldSlug]);
    if(r.error) throw r.error;
    var toUpdate = (r.data||[]).filter(function(p){
      return (p.tags||[]).some(function(t){ return t===oldSlug || slugify(t)===oldSlug; });
    });
    for(var i=0; i<toUpdate.length; i++){
      var p = toUpdate[i];
      var newTags = (p.tags||[]).map(function(t){
        var s = slugify(t)||t.trim();
        if(s===oldSlug) return newSlug;
        return t;
      });
      // Remove duplicatas
      newTags = newTags.filter(function(v,idx,arr){return arr.indexOf(v)===idx;});
      await sb.schema("blog").from("posts").update({tags: newTags}).eq("id", p.id);
    }
  }

  async function removeTagFromPosts(slug){
    var r = await sb.schema("blog").from("posts").select("id,tags").contains("tags", [slug]);
    if(r.error) throw r.error;
    var toUpdate = (r.data||[]).filter(function(p){
      return (p.tags||[]).some(function(t){ return (slugify(t)||t.trim())===slug; });
    });
    for(var i=0; i<toUpdate.length; i++){
      var p = toUpdate[i];
      var newTags = (p.tags||[]).filter(function(t){
        return (slugify(t)||t.trim()) !== slug;
      });
      await sb.schema("blog").from("posts").update({tags: newTags}).eq("id", p.id);
    }
  }

  $("btnRenameTag").onclick = async function(){
    $("mergeError").textContent = "";
    var fromSlug = $("mergeFrom").value;
    var toName = $("mergeTo").value.trim();
    var toSlug = slugify(toName);
    if(!fromSlug){ $("mergeError").textContent = "Selecione a tag de origem."; return; }
    if(!toSlug){ $("mergeError").textContent = "Informe o novo nome."; return; }
    if(!confirm("Renomear \""+fromSlug+"\" para \""+toSlug+"\" em todos os posts?")) return;
    try{
      await renameTagInPosts(fromSlug, toName, toSlug);
      await refreshPosts();
      await refreshTags();
      $("mergeTo").value = "";
      $("mergeFrom").value = "";
      toast("Tag renomeada em todos os posts!");
    }catch(err){
      $("mergeError").textContent = "Erro: "+err.message;
      toast("Erro: "+err.message);
    }
  };

  async function refreshUsers(){
    try{
      var r=await sb.schema("blog").from("profiles").select("*").order("criado_em",{ascending:false});
      if(r.error) throw r.error;
      users=(r.data||[]).map(function(u){return {id:u.id,nome:u.nome||"-",email:u.email,papel:u.papel};});
    }catch(e){ toast("Erro ao carregar usuários: "+e.message); users=[]; }
    renderUsers();
  }
  function renderUsers(){
    var tbody=$("usersBody"); tbody.innerHTML="";
    if(!users.length){ tbody.innerHTML='<tr><td colspan="4" class="muted">Nenhum usuário.</td></tr>'; return; }
    users.forEach(function(u,idx){
      var tr=document.createElement("tr");
      tr.innerHTML="<td>"+esc(u.nome||"-")+"</td><td>"+esc(u.email)+"</td><td><span class=\"pill "+(u.papel==="admin"?"admin":"")+"\">"+esc(u.papel)+"</span></td><td><button class=\"btn btn-sm btn-danger\" data-i=\""+idx+"\">Remover</button></td>";
      tbody.appendChild(tr);
    });
    tbody.querySelectorAll("button[data-i]").forEach(function(b){ b.onclick=async function(){
      var i=parseInt(b.getAttribute("data-i"),10);
      if(!confirm("Remover o perfil de "+users[i].email+"?")) return;
      try{
        var r=await sb.schema("blog").from("profiles").delete().eq("id",users[i].id);
        if(r.error){ toast("Erro: "+r.error.message); return; }
        await refreshUsers(); toast("Perfil removido.");
      }catch(err){ toast("Erro: "+err.message); }
    }; });
  }
  $("btnAddUser").onclick=async function(){
    $("userError").textContent="";
    var nome=$("uNome").value.trim(), email=$("uEmail").value.trim().toLowerCase(), senha=$("uSenha").value, papel=$("uPapel").value;
    if(!email||!senha){ $("userError").textContent="Informe e-mail e senha."; return; }
    if(senha.length<6){ $("userError").textContent="Senha deve ter ao menos 6 caracteres."; return; }
    $("btnAddUser").disabled = true;
    try{
      // Usa cliente isolado sem persistir sessão para não deslogar o admin atual
      var tempSb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
        auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false, storageKey: "ure_signup_tmp" }
      });
      var su = await tempSb.auth.signUp({
        email: email,
        password: senha,
        options: { data: { nome: nome || email.split("@")[0], papel: papel } }
      });
      if(su.error){ $("userError").textContent=su.error.message; return; }
      var uidU=(su.data.user&&su.data.user.id)||null;
      if(uidU){
        var pi=await sb.schema("blog").from("profiles").upsert({
          id: uidU,
          email: email,
          nome: nome || email.split("@")[0],
          papel: papel
        }, { onConflict: "id" });
        if(pi.error){ $("userError").textContent="Conta criada, mas erro ao atualizar papel: "+pi.error.message; return; }
      }
      $("uNome").value=""; $("uEmail").value=""; $("uSenha").value="";
      await refreshUsers(); toast("Usuário cadastrado com sucesso!");
    }catch(err){
      $("userError").textContent=err.message;
    }finally{
      $("btnAddUser").disabled = false;
    }
  };

  async function doLogin(){
    $("loginError").textContent="";
    try{
      var r=await sb.auth.signInWithPassword({email:$("loginEmail").value.trim(),password:$("loginPass").value});
      if(r.error){ $("loginError").textContent=r.error.message; return; }
      session=r.data.session; showApp(); toast("Login realizado.");
    }catch(err){ $("loginError").textContent=err.message; }
  }
  $("btnLogin").onclick=doLogin;
  $("loginPass").addEventListener("keydown", function(e){ if(e.key==="Enter") doLogin(); });
  $("btnLogout").onclick=async function(){ await sb.auth.signOut(); session=null; showLogin(); };

  document.querySelectorAll(".tab").forEach(function(btn){
    btn.onclick=function(){
      document.querySelectorAll(".tab").forEach(function(b){b.classList.remove("active");});
      btn.classList.add("active");
      var t=btn.getAttribute("data-tab");
      ["posts","tags","users"].forEach(function(x){ $("tab-"+x).classList.toggle("hidden",x!==t); });
    };
  });

  (async function boot(){
    try{
      var r=await sb.auth.getSession();
      if(r.data && r.data.session){ session=r.data.session; showApp(); }
      else showLogin();
    }catch(e){ showLogin(); }
  })();
})();
</script>
</body>
</html>
