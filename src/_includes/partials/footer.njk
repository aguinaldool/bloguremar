<footer class="site-footer" role="contentinfo">
  <div class="footer-grid">
    <div class="footer-brand">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>
        <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
        <path d="M11.5 11.5a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
        <path d="M20.5 20.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
      </svg>
      <span class="logo-text">{{ site.shortName }}</span>
      <p class="footer-lead">{{ site.tagline }}</p>
    </div>

    <div class="footer-links">
      <h3 class="footer-title">Navegação</h3>
      <ul>
        {% for item in site.menu %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-links">
      <h3 class="footer-title">Utilidades</h3>
      <ul>
        {% for item in site.utilidades %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-contato">
      <h3 class="footer-title">Contato</h3>
      <ul>
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li>{{ site.telefone }}</li>
        <li>{{ site.endereco }}</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {{ site.year | default(now.year) }} {{ site.shortName }} — Secretaria da Educação do Estado de SP. Conteúdo institucional.</p>
    <div class="footer-social">
      {% for chave, link in site.redes %}
      <a href="{{ link }}" aria-label="{{ chave }}"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-{{ chave }}"/></svg></a>
      {% endfor %}
    </div>
  </div>
</footer>
