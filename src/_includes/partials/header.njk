<header class="site-header" role="banner">
  <div class="header-wrap">
    <div class="header-bar">
      <a class="logo" href="/" aria-label="{{ site.name }} — página inicial">
        <svg class="logo-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor" stroke-width=".8" opacity=".5"/>
          <path d="M12 4.5 14 12 12 19.5 10 12Z" fill="currentColor"/>
          <circle cx="12" cy="12" r="1.4" fill="#0A1512"/>
        </svg>
        <span class="logo-text">{{ site.shortName }}</span>
      </a>
    </div>
  </div>

  {% if site.demo %}
  <div class="demo-banner" role="status" aria-live="polite">
    <strong>Aviso:</strong> {{ site.demoAviso }}
  </div>
  {% endif %}
</header>
