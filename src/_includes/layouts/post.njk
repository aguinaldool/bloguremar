---
layout: layouts/base.njk
---
{% set pageTitle = title + " | " + site.shortName %}
{% set pageDesc = resumo %}
{% set bodyClass = "post" %}

<article class="article">
  <header class="article-header">
    <div class="article-meta">
      <svg class="ic" aria-hidden="true"><use href="#i-calendar"/></svg>
      <time datetime="{{ page.date | dateISO }}">{{ page.date | dateBR }}</time>
      <span>·</span>
      <span style="color:{{ categoria | sectionColor }}">{{ categoria | sectionLabel }}</span>
      {% if autor %}<span>·</span><svg class="ic" aria-hidden="true"><use href="#i-user"/></svg><span>{{ autor }}</span>{% endif %}
      <span>·</span>
      <span>{{ content | readingTime }} min de leitura</span>
    </div>

    <span class="article-category" style="background:{{ categoria | sectionColor }};">{{ categoria | sectionLabel }}</span>
    <h1 class="article-title">{{ title }}</h1>
    <p class="article-resumo">{{ resumo }}</p>

    {% if tags and tags.length %}
    <div class="tags">
      {% for tag in tags %}<span class="tag">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="article-cover">
    {{ page.fileSlug | coverSVG(title, categoria) | safe }}
  </div>

  <div class="article-body">
    {{ content | safe }}
  </div>

  <p style="margin-top:2rem;"><a href="/" class="btn btn-outline btn-sm"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-arr-l"/></svg> Voltar para o início</a></p>
</article>
