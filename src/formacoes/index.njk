---
layout: layouts/base.njk
title: "Formações"
description: "Formações continuadas e eventos para a rede de Marília."
permalink: /formacoes/
---

<header class="hero" style="padding-top:var(--space-10);padding-bottom:var(--space-6);">
  <div class="hero-content">
    <div class="hero-kicker"><span>Formações</span></div>
    <h1>Formações e eventos</h1>
    <p class="hero-lede">Formações continuadas, workshops e eventos para professores e gestores.</p>
  </div>
</header>

<section class="section">
  <div class="container">
    {% if collections.formacoes.length %}
    <div class="grid grid-3">
      {% for post in collections.formacoes %}
      <article class="card">
        <div class="card-image">
          <svg class="network-svg" viewBox="0 0 400 200" preserveAspectRatio="none" style="width:100%;height:100%;background:#F1F5FA;" aria-hidden="true">
            <line x1="40" y1="160" x2="360" y2="60" stroke="#0D9488" stroke-width="2" opacity="0.2"/>
            <circle cx="360" cy="60" r="5" fill="#0D9488" opacity="0.3"/>
          </svg>
        </div>
        <div class="card-body">
          <div class="card-meta"><span>{{ post.date | dateBR }}</span><span>·</span><span style="color:var(--color-teal)">Formação</span></div>
          <h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="card-excerpt">{{ post.data.resumo }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p style="color:var(--color-muted);">Nenhuma formação publicada no momento.</p>
    {% endif %}
  </div>
</section>
