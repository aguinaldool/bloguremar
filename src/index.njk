---
layout: layouts/base.njk
title: "URE Marília — Caderno da Rede"
description: "Blog institucional da Unidade Regional de Ensino de Marília."
bodyClass: "home"
permalink: /
---

{% set featured = collections.featured | first %}
{% set recent = collections.posts %}

<header class="hero">
  <div class="hero-bg">
    <svg class="network-svg" viewBox="0 0 1200 500" preserveAspectRatio="none" aria-hidden="true">
      <line x1="100" y1="420" x2="350" y2="180" stroke="#2563EB" stroke-width="2" opacity="0.12"/>
      <line x1="350" y1="180" x2="620" y2="340" stroke="#2563EB" stroke-width="2" opacity="0.12"/>
      <line x1="620" y1="340" x2="900" y2="140" stroke="#0D9488" stroke-width="2" opacity="0.12"/>
      <line x1="900" y1="140" x2="1150" y2="400" stroke="#0D9488" stroke-width="2" opacity="0.12"/>
      <circle cx="350" cy="180" r="6" fill="#2563EB" opacity="0.2"/>
      <circle cx="620" cy="340" r="6" fill="#2563EB" opacity="0.2"/>
      <circle cx="900" cy="140" r="6" fill="#0D9488" opacity="0.2"/>
    </svg>
  </div>
  <div class="hero-content">
    {% if featured %}
    <div class="hero-kicker"><span>{{ featured.data.categoria | sectionLabel }}</span> · Destaque</div>
    <h1><a href="{{ featured.url }}" style="color:inherit;text-decoration:none;">{{ featured.data.title }}</a></h1>
    <p class="hero-lede">{{ featured.data.resumo }}</p>
    <div class="hero-actions">
      <a href="{{ featured.url }}" class="btn btn-primary">Ler notícia <svg class="ic ic-sm" aria-hidden="true"><use href="#i-arr-r"/></svg></a>
    </div>
    {% else %}
    <div class="hero-kicker"><span>{{ site.shortName }}</span></div>
    <h1>{{ site.tagline }}</h1>
    <p class="hero-lede">{{ site.description }}</p>
    {% endif %}
  </div>
</header>

{% set allTags = [] %}
{% for p in collections.posts %}
  {% for t in p.data.tags %}
    {% set allTags = (allTags.push(t), allTags) %}
  {% endfor %}
{% endfor %}
{% set tagCounts = {} %}
{% for t in allTags %}
  {% if tagCounts[t] %}{% set tagCounts = tagCounts %}{% endif %}
{% endfor %}

<section class="section-sm">
  <div class="container">
    <div class="layout-with-sidebar">
      <aside class="tags-sidebar" aria-label="Filtrar por tags">
        <h3>Tags</h3>
        <div class="tags-grid" id="tagsGrid">
          {% set seen = [] %}
          {% for p in collections.posts %}
            {% for t in p.data.tags %}
              {% if t not in seen %}
                {% set seen = (seen.push(t), seen) %}
                {% set count = 0 %}
                {% for p2 in collections.posts %}{% if t in p2.data.tags %}{% set count = count + 1 %}{% endif %}{% endfor %}
                <button type="button" class="tag-btn" data-tag="{{ t }}">{{ t }} <span class="count">{{ count }}</span></button>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
        <button type="button" class="btn btn-outline btn-sm tags-clear-btn" id="tagsClear" hidden>Limpar filtro</button>
      </aside>

      <div>
        <div class="list-header">
          <h2 class="list-title">Publicações</h2>
        </div>
        <div class="grid grid-3" id="postsGrid">
          {% for p in collections.posts %}
          <article class="card post-card-item" data-tags="{{ p.data.tags | join(',') }}">
            <div class="card-image">
              <svg class="network-svg" viewBox="0 0 400 200" preserveAspectRatio="none" style="width:100%;height:100%;background:#F1F5FA;" aria-hidden="true">
                <line x1="40" y1="160" x2="360" y2="60" stroke="{{ p.data.categoria | sectionColor }}" stroke-width="2" opacity="0.2"/>
                <circle cx="360" cy="60" r="5" fill="{{ p.data.categoria | sectionColor }}" opacity="0.3"/>
                <circle cx="200" cy="120" r="4" fill="{{ p.data.categoria | sectionColor }}" opacity="0.2"/>
              </svg>
            </div>
            <div class="card-body">
              <div class="card-meta">
                <span>{{ p.date | dateBR }}</span>
                <span>·</span>
                <span style="color:{{ p.data.categoria | sectionColor }}">{{ p.data.categoria | sectionLabel }}</span>
              </div>
              <h3 class="card-title"><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
              <p class="card-excerpt">{{ p.data.resumo }}</p>
              {% if p.data.tags and p.data.tags.length %}
              <div class="tags">
                {% for tag in p.data.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
              </div>
              {% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
        <div id="postsEmptyFilter" class="posts-empty-filter" hidden>Nenhuma publicação encontrada para esta tag.</div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var grid = document.getElementById('tagsGrid');
  var cards = document.querySelectorAll('.post-card-item');
  var clearBtn = document.getElementById('tagsClear');
  var empty = document.getElementById('postsEmptyFilter');
  if(!grid) return;
  var active = null;
  function apply(){
    var visible = 0;
    cards.forEach(function(card){
      var tags = (card.getAttribute('data-tags')||'').split(',');
      var show = !active || tags.indexOf(active) !== -1;
      card.classList.toggle('is-hidden', !show);
      if(show) visible++;
    });
    clearBtn.hidden = !active;
    if(empty) empty.hidden = visible > 0;
  }
  grid.addEventListener('click', function(e){
    var btn = e.target.closest('.tag-btn');
    if(!btn) return;
    var tag = btn.getAttribute('data-tag');
    active = (active === tag) ? null : tag;
    grid.querySelectorAll('.tag-btn').forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-tag')===active); });
    apply();
  });
  clearBtn.addEventListener('click', function(){
    active = null;
    grid.querySelectorAll('.tag-btn').forEach(function(b){ b.classList.remove('active'); });
    apply();
  });
})();
</script>


