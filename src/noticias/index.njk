---
layout: layouts/base.njk
title: "Notícias"
description: "Acompanhe as publicações da URE Marília."
permalink: /noticias/
---

<header class="hero" style="padding-top:var(--space-10);padding-bottom:var(--space-6);">
  <div class="hero-content">
    <div class="hero-kicker"><span>Notícias</span></div>
    <h1>Notícias da rede</h1>
    <p class="hero-lede">Acompanhe as últimas publicações da URE Marília: notícias, comunicados, formações e projetos.</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="grid grid-3">
      {% for post in collections.posts %}
      <article class="card">
        <div class="card-image">
          <svg class="network-svg" viewBox="0 0 400 200" preserveAspectRatio="none" style="width:100%;height:100%;background:#F1F5FA;" aria-hidden="true">
            <line x1="40" y1="160" x2="360" y2="60" stroke="{{ post.data.categoria | sectionColor }}" stroke-width="2" opacity="0.2"/>
            <circle cx="360" cy="60" r="5" fill="{{ post.data.categoria | sectionColor }}" opacity="0.3"/>
          </svg>
        </div>
        <div class="card-body">
          <div class="card-meta">
            <span>{{ post.date | dateBR }}</span>
            <span>·</span>
            <span style="color:{{ post.data.categoria | sectionColor }}">{{ post.data.categoria | sectionLabel }}</span>
          </div>
          <h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p class="card-excerpt">{{ post.data.resumo }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
